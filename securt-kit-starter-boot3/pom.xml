<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.genkidoudou</groupId>
        <artifactId>securt-kit</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>securt-kit-starter-boot3</artifactId>

    <name>securt-kit-starter-boot3</name>
    <description>Spring Boot 3.x starter for Securt-Kit (auto-config + monitor servlet).</description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 单独构建本模块时也使用 Boot 3 BOM，避免继承父 POM 默认的 Boot 2.7 -->
        <spring-boot.version>${spring-boot-3.version}</spring-boot.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.genkidoudou.core</groupId>
            <artifactId>securt-kit-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 共享监控 UI 内核（无 Servlet 依赖） -->
        <dependency>
            <groupId>io.github.genkidoudou</groupId>
            <artifactId>securt-kit-monitor</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- MyBatis 通道（mode=MYBATIS 时使用） -->
        <dependency>
            <groupId>io.github.genkidoudou</groupId>
            <artifactId>securt-kit-mybatis</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.mybatis</groupId>
            <artifactId>mybatis</artifactId>
            <version>3.5.13</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- jakarta servlet (for Boot 3.x) - 仅薄 Servlet 适配层使用 -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <!-- Maven Compiler Plugin - 配置 Java 17 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                    <encoding>UTF-8</encoding>
                    <!-- 保留参数名信息，用于 Spring MVC 参数绑定 -->
                    <parameters>true</parameters>
                </configuration>
            </plugin>

            <!-- Maven Jar Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
            </plugin>

            <!-- Maven Source Plugin - 生成源码 jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.2.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>
</project>
